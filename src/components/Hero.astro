---
import projekt from '../data/pl/projekt-2848.json';

const fmt = (iso: string) => new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
const dzis = fmt(new Date().toISOString().slice(0, 10));

const kroki = ['Wpłynięcie do Sejmu', 'I czytanie', 'Komisja', 'II i III czytanie', 'Senat', 'Prezydent', 'Dziennik Ustaw'];

// Siatka działek: rekurencyjny podział prostokąta z ziarnem, ten sam układ przy każdym buildzie.
function parcels(seed: number, depth: number, w = 1200, h = 720) {
  let s = seed;
  const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
  const lines: string[] = [];
  const split = (x: number, y: number, cw: number, ch: number, d: number) => {
    if (d === 0 || cw < 70 || ch < 70) return;
    const vertical = cw > ch ? rnd() > 0.2 : rnd() > 0.8;
    const t = 0.3 + rnd() * 0.4;
    if (vertical) {
      const cx = Math.round(x + cw * t);
      lines.push(`M${cx} ${y}V${y + ch}`);
      split(x, y, cx - x, ch, d - 1); split(cx, y, x + cw - cx, ch, d - 1);
    } else {
      const cy = Math.round(y + ch * t);
      lines.push(`M${x} ${cy}H${x + cw}`);
      split(x, y, cw, cy - y, d - 1); split(x, cy, cw, y + ch - cy, d - 1);
    }
  };
  split(0, 0, w, h, depth);
  return lines.join('');
}
const warstwy = [parcels(7, 3), parcels(41, 5), parcels(97, 7)];
---
<section class="hero" id="stan" aria-labelledby="h1">
  <div class="hero__grid" aria-hidden="true">
    {warstwy.map((d, i) => (
      <svg class={`layer layer--${i}`} viewBox="0 0 1200 720" preserveAspectRatio="xMidYMid slice"><path d={d} pathLength="1" /></svg>
    ))}
  </div>
  <div class="wrap hero__in">
    <p class="eyebrow">Stan na {dzis}</p>
    <h1 id="h1">Czy w Polsce będzie podatek katastralny?</h1>
    <p class="lead">Na dziś podatek katastralny <strong>nie obowiązuje</strong>. W Sejmie leży poselski projekt
      (druk nr {projekt.druk}), który dla budynków i lokali mieszkalnych zastępuje stawkę od metra stawką od wartości.
      Śledzimy każdy etap i podajemy źródło każdej informacji, bez stanowiska za ani przeciw.</p>

    <div class="status reveal">
      <dl class="status__facts">
        <div><dt>Obowiązuje</dt><dd>Nie</dd></div>
        <div><dt>Projekt</dt><dd>Druk nr {projekt.druk}, poselski</dd></div>
        <div><dt>Ostatni etap</dt><dd>{projekt.etap}</dd></div>
        <div><dt>Proponowany start</dt><dd>{fmt(projekt.wejscie_w_zycie)}</dd></div>
      </dl>
      <ol class="steps" aria-label="Etapy procedury ustawodawczej">
        {kroki.map((k, i) => (
          <li class:list={['step', { 'is-done': i < projekt.krok_procedury, 'is-now': i === projekt.krok_procedury }]}
              aria-current={i === projekt.krok_procedury ? 'step' : undefined}>
            <span class="step__dot" aria-hidden="true"></span><span class="step__label">{k}</span>
          </li>
        ))}
      </ol>
      <p class="src">Źródło: <a href={projekt.zrodla[0].url}>Sejm RP, przebieg procesu legislacyjnego</a>, sprawdzone {fmt(projekt.zrodla[0].zweryfikowano)}. Etap „I czytanie” oznacza, że projekt czeka na pierwsze czytanie na posiedzeniu Sejmu.</p>
    </div>

    <div class="hero__cta">
      <a class="btn" href="#kalkulator">Policz, ile wyniósłby podatek</a>
      <a class="btn btn--ghost" href="#projekt">Co zakłada projekt</a>
      <a class="hero__rss" href={`${import.meta.env.BASE_URL}zmiany.xml`}>Śledź zmiany (RSS)</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: clip; padding-block: clamp(56px, 9vw, 120px) clamp(56px, 8vw, 96px); isolation: isolate; }
  /* Zanik siatki gradientem w kolorze tła, nie maską: maska nad przesuwanymi warstwami wymusza ponowny raster. */
  .hero__grid { position: absolute; inset: -10% 0 0; z-index: -1; pointer-events: none; }
  .hero__grid::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 35%, var(--bg) 92%); }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; }
  .layer path { fill: none; stroke: var(--grid); stroke-dasharray: 1; stroke-dashoffset: 0; }
  .layer--0 path { stroke-width: 2.4; }
  .layer--1 path { stroke-width: 1.4; }
  .layer--2 path { stroke-width: 0.9; opacity: 0.8; }

  @media (prefers-reduced-motion: no-preference) {
    .layer path { animation: draw var(--t-3) var(--ease-io) both; }
    .layer--1 path { animation-duration: 1100ms; animation-delay: 150ms; }
    .layer--2 path { animation-duration: 1500ms; animation-delay: 300ms; }
    @keyframes draw { from { stroke-dashoffset: 1; } }
    @supports (animation-timeline: scroll()) {
      .layer { animation: drift linear both; }
      /* Timeline w osobnej regule: minifikator skleja go ze skrótem `animation`, a Chrome odrzuca taki skrót w całości. */
      .hero__grid .layer { animation-timeline: scroll(root); animation-range: 0 100vh; }
      .layer--0 { --d: 4%; } .layer--1 { --d: 9%; } .layer--2 { --d: 12%; }
      @keyframes drift { to { transform: translateY(var(--d)); } }
    }
  }

  .hero__in { position: relative; }
  .hero h1 { max-width: 16ch; }
  .status { margin-top: 40px; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: clamp(18px, 3vw, 32px); max-width: 980px; }
  .status__facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 28px; margin: 0 0 28px; }
  .status__facts dt { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 4px; }
  .status__facts dd { margin: 0; font-weight: 600; line-height: 1.35; }
  .status__facts div:first-child dd { font-family: var(--serif); font-size: 1.6rem; color: var(--accent); }

  .steps { list-style: none; margin: 0 0 18px; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); position: relative; }
  .step { position: relative; padding-top: 22px; font-size: 0.82rem; color: var(--ink-3); line-height: 1.3; }
  .step::before { content: ''; position: absolute; top: 6px; left: 0; right: 0; height: 1px; background: var(--line-2); }
  .step.is-done::before { background: var(--accent); height: 2px; top: 5.5px; }
  .step__dot { position: absolute; top: 0; left: 0; width: 13px; height: 13px; border-radius: 50%; background: var(--surface); border: 1.5px solid var(--line-2); }
  .step.is-done .step__dot { background: var(--accent); border-color: var(--accent); }
  .step.is-now .step__dot { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); }
  .step.is-now { color: var(--ink); font-weight: 600; }
  .step__label { display: block; padding-right: 8px; }

  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 32px; }
  .hero__rss { font-size: 0.92rem; }

  @media (max-width: 760px) {
    .status__facts { grid-template-columns: 1fr 1fr; }
    .steps { grid-template-columns: 1fr; gap: 0; }
    .step { padding: 0 0 14px 26px; }
    .step::before { top: 13px; bottom: 0; left: 6px; right: auto; width: 1px; height: auto; }
    .step.is-done::before { width: 2px; left: 5.5px; top: 13px; height: auto; }
    .step:last-child::before { display: none; }
  }
</style>
