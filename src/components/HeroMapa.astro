---
import projekt from '../data/pl/projekt-2848.json';
import { mapa, dane, klasa, etykieta, pct, grupa, legenda, PODSTAWA, NAZWA_PODSTAWY, KROTKO } from '../lib/europa';
import { status } from '../lib/status';
const pol = mapa.countries.find((c) => c.iso === 'POL')!;
const inne = mapa.countries.filter((c) => c.iso !== 'POL');
const [x0, y0, x1, y1] = mapa.bbox;
// Na telefonie kadr ciasno wokół Europy; na desktopie pełne 1600×1000 z miejscem na tytuł.
const vbMobile = `${x0 - 20} ${y0} ${x1 - x0 + 40} ${y1 - y0 + 20}`;
const daneJs = Object.fromEntries(Object.entries(dane).map(([k, v]) => {
  const p = PODSTAWA[k];
  return [k, { ...v, s: v.g === undefined ? 'brak danych OECD' : `${pct(v.g)} PKB · ${v.y}`, p: p?.podstawa, pn: p ? NAZWA_PODSTAWY[p.podstawa] : '', pk: p ? KROTKO[p.podstawa] : '', po: p?.opis ?? '', pu: p?.url ?? '', pw: p?.pewnosc ?? '' }];
}));
const ile = (k: string) => Object.values(PODSTAWA).filter((p) => p.podstawa === k).length;
const legendaPodstawy = (['wartosc', 'mieszany', 'powierzchnia', 'brak'] as const).map((k) => [k, NAZWA_PODSTAWY[k], ile(k)] as const);
const p = (iso: string) => PODSTAWA[iso]?.podstawa ?? 'brak_danych';

// Siatka działek pod mapą: rekurencyjny podział z ziarnem, ten sam układ przy każdym buildzie.
function parcels(seed: number, depth: number, w = 1600, h = 1000) {
  let s = seed;
  const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
  const lines: string[] = [];
  const split = (x: number, y: number, cw: number, ch: number, d: number) => {
    if (d === 0 || cw < 90 || ch < 90) return;
    const vertical = cw > ch ? rnd() > 0.2 : rnd() > 0.8;
    const t = 0.3 + rnd() * 0.4;
    if (vertical) {
      const cx = Math.round(x + cw * t);
      lines.push(`M${cx} ${y}V${y + ch}`);
      split(x, y, cx - x, ch, d - 1); split(cx, y, x + cw - cx, ch, d - 1);
    } else {
      const cy = Math.round(y + ch * t);
      lines.push(`M${x} ${cy}H${x + cw}`);
      split(x, y, cw, cy - y, d - 1); split(x, cy, cw, y + ch - cy, d - 1);
    }
  };
  split(0, 0, w, h, depth);
  return lines.join('');
}
const warstwy = [parcels(7, 3), parcels(41, 5), parcels(97, 7)];
---
<!-- Status poza warstwą intro: widoczny od pierwszego malowania, nie czeka na animację mapy. -->
<div class="sb" role="status">
  <p class="sb__in">
    <strong class="sb__stan">{status.obowiazuje ? 'Uchwalony' : 'Nie obowiązuje'}</strong>
    <span>Druk nr {status.druk}: {status.etap}</span>
    <span class="sb__d">Monitoring Sejmu: <time datetime={status.sprawdzonoIso}>{status.sprawdzono}</time></span>
    <span class="sb__d">Ostatnia zmiana w procesie: {status.zmiana}</span>
    <span class="sb__d">Przegląd redakcji: {status.przeglad}</span>
  </p>
</div>
<section class="hero" id="mapa" aria-labelledby="h1" data-vb={mapa.viewBox} data-vb-mobile={vbMobile}>
  <div class="hero__content">
    <div class="hero__head">
      <p class="eyebrow">Monitor projektu ustawy</p>
      <h1 id="h1">Czy będzie podatek katastralny w&nbsp;Polsce?</h1>
      <span class="hero__line" aria-hidden="true"></span>
    </div>
    <div class="hero__rest">
      <p class="lead">Na dziś <strong>nie obowiązuje</strong>. W Sejmie czeka poselski projekt (druk nr {projekt.druk}).
        Mapa pokazuje, gdzie w Europie podatek od nieruchomości liczy się od wartości, a gdzie od powierzchni, jak dziś w Polsce.</p>
      <div class="hero__cta">
        <a class="btn" href="#kalkulator">Policz, ile wyniósłby podatek</a>
        <a class="btn btn--ghost" href="#stan">Na jakim etapie jest projekt</a>
      </div>
    </div>
  </div>

  <div class="hero__map">
    <div class="hero__grid" aria-hidden="true">
      {warstwy.map((d, i) => <svg class={`layer layer--${i}`} viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice"><path d={d} pathLength="1" /></svg>)}
    </div>
    <svg class="hm" data-tryb="podstawa" viewBox={mapa.viewBox} preserveAspectRatio="xMaxYMid meet" role="group"
         aria-label="Mapa Europy: wpływy z podatków od nieruchomości jako % PKB. Strzałki przechodzą między państwami, Enter pokazuje szczegóły.">
      {inne.map((c) => c.iso === 'RUS'
        ? <path class="c c--bg" d={c.d} data-gr="wschod" data-c={c.c.join(',')} aria-hidden="true" />
        : <path class={`c c--${klasa(dane[c.iso].g)}`} d={c.d} data-iso={c.iso} data-p={p(c.iso)} data-gr={grupa(c.iso)} data-c={c.c.join(',')} tabindex="-1" role="button" aria-label={etykieta(c.iso)} />)}
      {mapa.dots.map((d) => (
        <circle class={`c dot c--${klasa(dane[d.iso].g)}`} cx={d.x} cy={d.y} r="7" data-iso={d.iso} data-p={p(d.iso)} data-gr={grupa(d.iso)} data-c={`${d.x},${d.y}`}
          {...(d.iso === 'MLT' ? { tabindex: '-1', role: 'button', 'aria-label': etykieta(d.iso) } : { 'aria-hidden': 'true' })} />
      ))}
      <defs>
        <!-- Mieszany system: paski „od wartości” na tle „od powierzchni”. -->
        <pattern id="mieszany" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="9" height="9" style="fill: var(--k-pow)" />
          <rect width="4" height="9" style="fill: var(--k-wart)" />
        </pattern>
        <!-- Polska podświetlona w całości: jaśniejszy środek, czerwień flagi przy granicy. -->
        <radialGradient id="pl-fill" cx="50%" cy="42%" r="62%">
          <stop offset="0" style="stop-color: var(--pl-a)" />
          <stop offset="1" style="stop-color: var(--pl-b)" />
        </radialGradient>
      </defs>
      <g class="pl">
        <g class="pl__ext" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7].map((k) => <path d={pol.d} transform={`translate(0 ${k - 7})`} />)}</g>
        <g class="pl__top">
          <path class="c pl__land" d={pol.d} data-iso="POL" data-c={pol.c.join(',')} tabindex="0" role="button" aria-label={etykieta('POL')} />
        </g>
      </g>
    </svg>
    <div class="ster">
      <label class="sr-only" for="wybor-panstwa">Wybierz państwo</label>
      <select id="wybor-panstwa" class="ster__wybor">
        <option value="">Wybierz państwo…</option>
        {[...Object.entries(dane)].sort((a, b) => a[1].n.localeCompare(b[1].n, 'pl')).map(([iso, d]) => <option value={iso}>{d.n}</option>)}
      </select>
      <div class="ster__zoom" role="group" aria-label="Powiększenie mapy">
        <button type="button" data-zoom="1.6" aria-label="Przybliż">+</button>
        <button type="button" data-zoom="0.625" aria-label="Oddal">−</button>
        <button type="button" data-zoom="0" aria-label="Pokaż całą mapę">⤢</button>
      </div>
    </div>
    <div class="pl-label" aria-hidden="true" data-c={pol.c.join(',')}>
      <svg width="56" height="40"><path d="M0 40 L24 6 H56" /></svg>
      <p><b>Polska</b><span>dziś podatek od m² · {pct(dane.POL.g!)} PKB</span></p>
    </div>
  </div>

  <div class="hero__legend">
    <div class="tryb" role="group" aria-label="Co pokazuje mapa">
      <button type="button" data-tryb="podstawa" aria-pressed="true">Podatek od wartości</button>
      <button type="button" data-tryb="pkb" aria-pressed="false">Wpływy (% PKB)</button>
    </div>
    <ul class="lg lg--podstawa" aria-label="Legenda: podstawa podatku">
      {legendaPodstawy.map(([k, t, n]) => <li><i class={`sw sw--${k}`}></i>{t}<span class="lg__n">{n}</span></li>)}
      <li><i class="sw sw--pl"></i>Polska: dziś od powierzchni, projekt od wartości</li>
    </ul>
    <ul class="lg lg--pkb" aria-label="Legenda: % PKB" hidden>
      {legenda.map(([k, t]) => <li><i class={`sw c--${k}`}></i>{t}</li>)}
    </ul>
  </div>
  <div class="tip" hidden><p class="tip__n"></p><p class="tip__v"></p></div>
  <aside class="panel" hidden tabindex="-1" aria-live="polite">
    <button class="panel__x" type="button" aria-label="Zamknij szczegóły">×</button>
    <div class="panel__body"></div>
  </aside>
  <script is:inline type="application/json" class="hero__dane" set:html={JSON.stringify(daneJs)}></script>
  <script is:inline>
  (() => {
    const hero = document.currentScript.closest('.hero');
    const svg = hero.querySelector('.hm');
    const box = hero.querySelector('.hero__map');
    const label = hero.querySelector('.pl-label');
    const tip = hero.querySelector('.tip');
    const panel = hero.querySelector('.panel');
    const dane = JSON.parse(hero.querySelector('.hero__dane').textContent);
    const root = document.documentElement;
    const mq = matchMedia('(max-width: 760px)');
    const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
    const xy = (el) => el.dataset.c.split(',').map(Number);

    // Kadr przed pierwszym malowaniem (skrypt inline). Desktop: cała mapa przy prawej krawędzi, Atlantyk po lewej
    // zostaje na tytuł. Telefon: ciasny kadr wokół Europy wypełniający pole.
    let kadr = function () {
      svg.setAttribute('viewBox', mq.matches ? hero.dataset.vbMobile : hero.dataset.vb);
      svg.setAttribute('preserveAspectRatio', mq.matches ? 'xMidYMid slice' : 'xMaxYMid meet');
      etykieta();
    };
    function etykieta() {
      const [x, y] = xy(label), pt = svg.createSVGPoint();
      pt.x = x; pt.y = y - 7;
      const p = pt.matrixTransform(svg.getScreenCTM()), b = box.getBoundingClientRect();
      label.style.left = `${p.x - b.left}px`; label.style.top = `${p.y - b.top}px`;
      // Przy prawej krawędzi (telefon) etykieta odbija się na lewo od punktu.
      label.classList.toggle('is-left', !mq.matches && p.x - b.left + 260 > b.width);
    }
    kadr();
    mq.addEventListener('change', () => kadr());
    addEventListener('resize', etykieta);

    // Podpowiedź i panel szczegółów
    const pct = (v) => v.toLocaleString('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%';
    function pokaz(el, x, y) {
      const d = dane[el.dataset.iso], b = hero.getBoundingClientRect();
      tip.querySelector('.tip__n').textContent = d.n;
      tip.querySelector('.tip__v').textContent = d.pk ? `${d.pk} · ${d.s}` : d.s;
      if (x === undefined) { const r = el.getBoundingClientRect(); x = r.left + r.width / 2; y = r.top + r.height / 2; }
      tip.style.transform = `translate(${Math.min(x - b.left + 14, b.width - 210)}px, ${y - b.top - 70}px)`;
      tip.hidden = false;
    }
    let aktywne = null;
    function wybierz(el) {
      aktywne?.classList.remove('is-on'); aktywne = el; el.classList.add('is-on');
      const iso = el.dataset.iso, d = dane[iso], pl = dane.POL.g;
      panel.querySelector('.panel__body').innerHTML = `
        <p class="panel__k">Wybrane państwo</p><h2 class="panel__h">${d.n}</h2>
        ${d.p ? `<p class="panel__p panel__p--${d.p}">${d.pn}</p><p class="panel__opis">${d.po}${d.pw === 'niska' ? ' <em>(klasyfikacja umowna)</em>' : ''} <a href="${d.pu}" rel="noopener" target="_blank">Źródło</a></p>` : ''}
        ${d.g === undefined ? '<p>OECD nie publikuje danych o wpływach z podatków od nieruchomości dla tego państwa.</p>' : `
        <dl><div><dt>Wpływy jako % PKB</dt><dd>${pct(d.g)}</dd></div>
        <div><dt>Udział we wszystkich podatkach</dt><dd>${d.t === undefined ? '—' : pct(d.t)}</dd></div>
        <div><dt>Rok danych</dt><dd>${d.y}</dd></div></dl>
        ${iso === 'POL' ? '' : `<div class="cmpbar" aria-hidden="true"><span style="--w:${Math.min(d.g / 3, 1)}"><i></i>${d.n}</span><span class="is-pl" style="--w:${Math.min(pl / 3, 1)}"><i></i>Polska</span></div>`}`}
        <p class="panel__more">${iso === 'POL'
          ? 'Dziś podatek od powierzchni. W Sejmie projekt podatku od wartości dla mieszkań (druk nr 2848). <a href="#projekt">Co zakłada projekt</a>'
          : 'Szczegółowy opis (stawki, ostatnia reforma, skutki) w przygotowaniu.'}</p>`;
      const bylZamkniety = panel.hidden;
      panel.hidden = false;
      rozwin(bylZamkniety);
    }
    // Panel rozwija się z góry (clip-path), treść wpływa wiersz po wierszu, paski dociągają do wartości.
    const ruch = () => !matchMedia('(prefers-reduced-motion: reduce)').matches;
    function rozwin(odZera) {
      if (!ruch()) return;
      if (odZera) panel.animate([{ clipPath: 'inset(0 0 100% 0 round 4px)' }, { clipPath: 'inset(0 0 0% 0 round 4px)' }], { duration: 560, easing: ease });
      const wiersze = panel.querySelectorAll('.panel__body > *:not(dl), .panel__body dl > div, .panel__body .cmpbar span');
      wiersze.forEach((el, i) => el.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }],
        { duration: 440, delay: (odZera ? 140 : 0) + i * 60, easing: ease, fill: 'backwards' }));
      panel.querySelectorAll('.cmpbar i').forEach((el, i) => el.animate([{ transform: 'scaleX(0)' }],
        { duration: 700, delay: (odZera ? 380 : 200) + i * 90, easing: ease, fill: 'backwards' }));
    }
    // Fokus wraca na państwo tylko przy zamknięciu klawiszem (Esc); po kliknięciu „×” nie, bo przeglądarka rysuje wtedy ramkę.
    function zamknij(zKlawiatury = false) {
      const koniec = () => { panel.hidden = true; aktywne?.classList.remove('is-on'); if (zKlawiatury) aktywne?.focus({ preventScroll: true }); aktywne = null; };
      if (!ruch()) return koniec();
      panel.animate([{ clipPath: 'inset(0 0 0% 0 round 4px)' }, { clipPath: 'inset(0 0 100% 0 round 4px)' }], { duration: 320, easing: 'cubic-bezier(0.65, 0, 0.35, 1)' }).finished.then(koniec);
    }
    const cel = (e) => e.target.closest?.('[data-iso]');

    // Przybliżanie i przesuwanie: zmiana viewBox. Kółko z ctrl/⌘ (i gest szczypania na gładziku), dwa palce
    // na telefonie, przyciski +/−. Jednym palcem/myszą przesuwamy dopiero po przybliżeniu, żeby nie blokować
    // przewijania strony.
    const vb = () => svg.getAttribute('viewBox').split(' ').map(Number);
    let baza = vb();
    const zKadru = kadr;
    kadr = function () { zKadru(); baza = vb(); svg.classList.remove('is-zoom'); };
    const doSvg = (cx, cy) => { const pt = svg.createSVGPoint(); pt.x = cx; pt.y = cy; return pt.matrixTransform(svg.getScreenCTM().inverse()); };
    function ustaw([x, y, w, h]) {
      w = Math.min(baza[2], Math.max(baza[2] / 8, w)); h = w * baza[3] / baza[2];
      x = Math.min(baza[0] + baza[2] - w, Math.max(baza[0], x));
      y = Math.min(baza[1] + baza[3] - h, Math.max(baza[1], y));
      svg.setAttribute('viewBox', `${x} ${y} ${w} ${h}`);
      svg.classList.toggle('is-zoom', w < baza[2] * 0.98);
      etykieta();
    }
    function zoomWokol(f, px, py) {
      const [x, y, w, h] = vb(), nw = w / f, nh = h / f;
      ustaw([px - (px - x) / f, py - (py - y) / f, nw, nh]);
    }
    let anim = 0;
    function jedz(cel, ms = 450) {
      cancelAnimationFrame(anim);
      const start = vb(), t0 = performance.now();
      if (!ruch()) return ustaw(cel);
      const krok = (t) => {
        const k = Math.min(1, (t - t0) / ms), e = 1 - Math.pow(1 - k, 4);
        ustaw(start.map((v, i) => v + (cel[i] - v) * e));
        if (k < 1) anim = requestAnimationFrame(krok);
      };
      anim = requestAnimationFrame(krok);
    }
    function przybliz(el) {
      const b = el.getBBox(), w = Math.max(b.width * 2.6, b.height * 2.6 * baza[2] / baza[3], baza[2] / 6), h = w * baza[3] / baza[2];
      jedz([b.x + b.width / 2 - w / 2, b.y + b.height / 2 - h / 2, w, h]);
    }
    hero.querySelectorAll('[data-zoom]').forEach((btn) => btn.addEventListener('click', () => {
      const f = +btn.dataset.zoom, [x, y, w, h] = vb();
      if (!f) return jedz(baza);
      const nw = w / f, nh = h / f;
      jedz([x + w / 2 - nw / 2, y + h / 2 - nh / 2, nw, nh], 300);
    }));
    svg.addEventListener('wheel', (e) => {
      if (!e.ctrlKey && !e.metaKey) return;
      e.preventDefault();
      const p = doSvg(e.clientX, e.clientY);
      zoomWokol(Math.exp(-e.deltaY * 0.01), p.x, p.y);
    }, { passive: false });
    const palce = new Map();
    let przesuniete = false, start = null, rozstaw = 0;
    const odleglosc = () => { const [a, b] = [...palce.values()]; return Math.hypot(a.x - b.x, a.y - b.y); };
    svg.addEventListener('pointerdown', (e) => {
      palce.set(e.pointerId, { x: e.clientX, y: e.clientY });
      przesuniete = false;
      start = { x: e.clientX, y: e.clientY };
      rozstaw = palce.size === 2 ? odleglosc() : 0;
    });
    svg.addEventListener('pointermove', (e) => {
      if (!palce.has(e.pointerId)) return;
      const poprz = palce.get(e.pointerId);
      palce.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (palce.size === 2) {
        const [a, b] = [...palce.values()], d = odleglosc(), m = doSvg((a.x + b.x) / 2, (a.y + b.y) / 2);
        if (rozstaw > 0) zoomWokol(d / rozstaw, m.x, m.y);
        rozstaw = d; przesuniete = true;
        return;
      }
      if (!svg.classList.contains('is-zoom')) return;
      if (Math.hypot(e.clientX - start.x, e.clientY - start.y) > 6) przesuniete = true;
      if (!przesuniete) return;
      const p1 = doSvg(poprz.x, poprz.y), p2 = doSvg(e.clientX, e.clientY), [x, y, w, h] = vb();
      ustaw([x - (p2.x - p1.x), y - (p2.y - p1.y), w, h]);
      tip.hidden = true;
    });
    const puszczony = (e) => { palce.delete(e.pointerId); rozstaw = 0; };
    svg.addEventListener('pointerup', puszczony);
    svg.addEventListener('pointercancel', puszczony);
    // Przeciągnięcie mapy nie otwiera panelu państwa, na którym się skończyło.
    svg.addEventListener('click', (e) => { if (przesuniete) { e.stopImmediatePropagation(); przesuniete = false; } }, true);
    hero.querySelector('.ster__wybor').addEventListener('change', (e) => {
      const iso = e.target.value; if (!iso) return;
      const el = svg.querySelector(`[data-iso="${iso}"][role=button]`) ?? svg.querySelector(`[data-iso="${iso}"]`);
      if (!el) return;
      przybliz(el); wybierz(el);
      if (mq.matches) panel.scrollIntoView({ behavior: ruch() ? 'smooth' : 'auto', block: 'nearest' });
    });
    svg.addEventListener('pointermove', (e) => { const el = cel(e); if (el && e.pointerType === 'mouse') pokaz(el, e.clientX, e.clientY); else tip.hidden = true; });
    svg.addEventListener('pointerleave', () => { tip.hidden = true; });
    svg.addEventListener('click', (e) => { const el = cel(e); if (el) wybierz(el); });
    panel.querySelector('.panel__x').addEventListener('click', () => zamknij());
    hero.querySelectorAll('.tryb button').forEach((b) => b.addEventListener('click', () => {
      svg.dataset.tryb = b.dataset.tryb;
      hero.querySelectorAll('.tryb button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      hero.querySelector('.lg--podstawa').hidden = b.dataset.tryb !== 'podstawa';
      hero.querySelector('.lg--pkb').hidden = b.dataset.tryb !== 'pkb';
    }));

    // Klawiatura: jeden przystanek Tab (Polska), strzałki przechodzą po państwach z zachodu na wschód.
    const kolejka = [...svg.querySelectorAll('[data-iso][role=button]')].sort((a, b) => xy(a)[0] - xy(b)[0]);
    svg.addEventListener('focusin', (e) => { const el = cel(e); if (el) pokaz(el); });
    svg.addEventListener('focusout', () => { tip.hidden = true; });
    svg.addEventListener('keydown', (e) => {
      const el = cel(e); if (!el) return;
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); wybierz(el); return; }
      const k = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
      if (!k) return;
      e.preventDefault();
      const n = kolejka[(kolejka.indexOf(el) + k + kolejka.length) % kolejka.length];
      el.tabIndex = -1; n.tabIndex = 0; n.focus();
    });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) zamknij(true); });

    if (!root.classList.contains('intro')) return;

    // Wejście: pytanie jako ekran ładowania → zjazd pod mapę → zachód, wschód, północ, południe → Polska wyrasta.
    const czekaj = (ms) => new Promise((r) => setTimeout(r, ms));
    const t0 = performance.now();
    (async () => {
      await Promise.race([document.fonts.ready, czekaj(1500)]);
