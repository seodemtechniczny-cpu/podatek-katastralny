---
import { panstwa, dane, pct, stats } from '../lib/europa';

const z = panstwa.map((c) => ({ iso: c.iso, ...dane[c.iso] }));
const ranking = z.filter((c) => c.g !== undefined).sort((a, b) => b.g! - a.g!);
const brak = z.filter((c) => c.g === undefined).map((c) => c.n).sort((a, b) => a.localeCompare(b, 'pl'));
const max = ranking[0].g!;
const pl = dane.POL;
---
<section class="section" id="europa" aria-labelledby="eu-h">
  <div class="wrap eu">
    <div class="eu__head">
      <p class="eyebrow">Europa</p>
      <h2 id="eu-h">Ile państwa Europy pobierają z podatków od nieruchomości?</h2>
      <p class="lead">Wpływy z cyklicznych podatków od nieruchomości jako odsetek PKB (OECD, kategoria 4100). W Polsce
        to {pct(pl.g!)} PKB ({pl.y}), {ranking.findIndex((c) => c.iso === 'POL') + 1}. miejsce na {ranking.length} państw z danymi.</p>
      <p>Stawek wprost porównać się nie da. Jedne państwa liczą podatek od wartości rynkowej, inne od dawnej wartości
        katastralnej albo od powierzchni, a stawki często ustalają gminy. Udział w PKB liczy wszystkie państwa tą samą metodą.</p>
      <p class="src">Dane: <a href={stats.url}>{stats.source}</a>, pobrane {stats.fetched}. Brak danych OECD: {brak.join(', ')}.</p>
    </div>
    <ol class="rank" aria-label="Państwa od najwyższego udziału w PKB">
      {ranking.map((c, i) => (
        <li class:list={['rank__row', { 'is-pl': c.iso === 'POL' }]} style={`--w:${c.g! / max}`}>
          <span class="rank__n">{i + 1}.</span>
          <span class="rank__name">{c.n}</span>
          <span class="rank__bar" aria-hidden="true"><i></i></span>
          <span class="rank__v">{pct(c.g!)}<small>{c.t === undefined ? '' : ` · ${pct(c.t)} podatków`}</small></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .eu { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; }
  .eu__head { position: sticky; top: 96px; align-self: start; }
  .rank { list-style: none; margin: 0; padding: 0; font-variant-numeric: tabular-nums; }
  .rank__row { display: grid; grid-template-columns: 30px minmax(0, 10rem) minmax(0, 1fr) 11rem; align-items: center; gap: 12px; padding: 7px 0; border-top: 1px solid var(--line); font-size: 0.93rem; }
  .rank__n { color: var(--ink-3); font-size: 0.8rem; }
  .rank__bar { height: 8px; background: var(--bg-2); overflow: clip; }
  .rank__bar i { display: block; height: 100%; background: var(--m3); transform-origin: 0 50%; transform: scaleX(var(--w)); }
  .rank__v small { color: var(--ink-3); font-size: 0.78rem; }
  .is-pl { font-weight: 650; }
  .is-pl .rank__bar i { background: #dc143c; }
  .is-pl .rank__name::after { content: ''; display: inline-block; width: 8px; height: 8px; margin-left: 8px; background: linear-gradient(#fff 50%, #dc143c 50%); border: 1px solid var(--line-2); vertical-align: 1px; }
  /* Linia pomiaru: pasek dociąga do wartości przy wejściu w widok. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rank__bar i { animation: miara linear both; }
      .rank .rank__bar i { animation-timeline: view(); animation-range: entry 10% entry 90%; }
      @keyframes miara { from { transform: scaleX(0); } }
    }
  }
  @media (max-width: 900px) {
    .eu { grid-template-columns: 1fr; gap: 24px; }
    .eu__head { position: static; }
    .rank__row { grid-template-columns: 26px minmax(0, 1fr) 6.5rem; }
    .rank__bar { grid-column: 2 / -1; grid-row: 2; }
    .rank__v small { display: none; }
  }
</style>
