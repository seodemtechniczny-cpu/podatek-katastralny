---
import zdarzenia from '../data/pl/os-czasu.json';

const TYP: Record<string, string> = { projekt: 'Projekt', etap: 'Sejm', wypowiedz: 'Wypowiedź', rekomendacja: 'Rekomendacja', stawki: 'Stawki', plan: 'Zapowiedź' };
type Z = (typeof zdarzenia)[number] & { dokladnosc?: string };
const fmt = (e: Z) => {
  const d = new Date(e.data);
  if (e.dokladnosc === 'rok') return String(d.getFullYear());
  return d.toLocaleDateString('pl-PL', e.dokladnosc === 'miesiac' ? { month: 'long', year: 'numeric' } : { day: 'numeric', month: 'long', year: 'numeric' });
};
// Od początku historii do dziś: najstarsze po lewej.
const lista = ([...zdarzenia] as Z[]).sort((a, b) => a.data.localeCompare(b.data));
const od = lista[0].data.slice(0, 4);
---
<section class="os" id="os-czasu" aria-labelledby="os-h">
  <div class="os__sticky">
    <div class="os__head">
      <div>
        <p class="eyebrow">Oś czasu · {od}–dziś</p>
        <h2 id="os-h">Co się wydarzyło w sprawie podatku katastralnego?</h2>
      </div>
      <p class="os__note">{lista.length} zdarzeń, każde ze źródłem. Nowe etapy w Sejmie sprawdzamy codziennie.{' '}
        <a href={`${import.meta.env.BASE_URL}zmiany.xml`}>Kanał zmian (RSS)</a></p>
    </div>
    <div class="os__view">
      <ol class="os__track">
        {lista.map((e) => (
          <li class="os__item">
            <p class="os__date"><time datetime={e.data}>{fmt(e)}</time></p>
            <span class="os__dot" aria-hidden="true"></span>
            <article class="os__card">
              <p class="os__meta"><span class="tag">{TYP[e.typ] ?? e.typ}</span> {e.kto}</p>
              <h3>{e.tytul}</h3>
              <p>{e.opis}</p>
              <p class="src">Źródło: <a href={e.zrodlo.url}>{e.zrodlo.nazwa}</a></p>
            </article>
          </li>
        ))}
      </ol>
    </div>
    <div class="os__progress" aria-hidden="true"><i></i></div>
  </div>
</section>

<script>
  // Przewijanie strony przesuwa oś w bok (CSS scroll-driven, bez przechwytywania kółka i dotyku).
  // JS tylko mierzy: o ile przesunąć ścieżkę i kiedy każda karta wchodzi. Bez wsparcia albo przy
  // ograniczonym ruchu zostaje zwykła oś przewijana palcem/kółkiem w poziomie.
  const sec = document.querySelector<HTMLElement>('.os')!;
  const track = sec.querySelector<HTMLElement>('.os__track')!;
  const ok = CSS.supports('animation-timeline: view()') && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  function mierz() {
    if (!ok) return;
    sec.classList.add('os--jazda');
    const vw = document.documentElement.clientWidth;
    const shift = Math.max(0, Math.round(track.scrollWidth - vw));
    sec.style.setProperty('--shift', `${shift}px`);
    // Krok co 1 px: ścieżka zawsze stoi na pełnym pikselu, więc tekst nie rozmywa się w Chrome bez GPU.
    track.style.animationTimingFunction = `steps(${Math.max(1, shift)})`;
    for (const li of track.children as HTMLCollectionOf<HTMLElement>) {
      // Karty widoczne od razu w kadrze nie czekają na wejście.
      li.classList.toggle('od-razu', li.offsetLeft < vw * 0.78);
      const a = shift ? Math.min(1, Math.max(0, (li.offsetLeft - vw * 0.78) / shift)) : 0;
      li.style.setProperty('--a', `${(a * 100).toFixed(2)}%`);
      li.style.setProperty('--b', `${Math.min(100, a * 100 + (shift ? (vw * 0.22 * 100) / shift : 0)).toFixed(2)}%`);
    }
  }
  mierz();
  addEventListener('resize', mierz);
  document.fonts?.ready.then(mierz);
</script>

<style>
  .os { position: relative; border-top: 1px solid var(--line); background: var(--bg); }
  .os__sticky { padding-block: clamp(56px, 8vw, 96px); }
  .os__head { padding-inline: var(--gut); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 40px; margin-bottom: 28px; }
  .os__head h2 { margin: 0; max-width: 20ch; }
  .os__note { max-width: 42ch; color: var(--ink-2); font-size: 0.95rem; margin: 0; }

  /* Domyślnie (bez scroll-timeline, ograniczony ruch): oś przewijana w poziomie, karty przyciągane. */
  .os__view { overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: thin; }
  .os__track { list-style: none; margin: 0; display: flex; gap: 20px; width: max-content; padding: 0 var(--gut) 8px; position: relative; }
  .os__track::before { content: ''; position: absolute; left: 0; right: 0; top: 2.35rem; height: 1px; background: var(--line-2); }
  .os__item { width: clamp(260px, 26vw, 360px); scroll-snap-align: start; position: relative; }
  .os__date { margin: 0 0 18px; font-size: 0.9rem; font-weight: 650; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; min-height: 1.4em; }
  .os__dot { position: absolute; top: calc(2.35rem - 6px); left: 0; width: 13px; height: 13px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); }
  .os__card { margin-top: 26px; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 18px 20px; }
  .os__meta { margin: 0 0 8px; font-size: 0.82rem; color: var(--ink-3); }
  .tag { display: inline-block; font-size: 0.7rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 7px; border: 1px solid var(--line-2); border-radius: 2px; color: var(--ink-2); margin-right: 6px; }
  .os__card h3 { font-size: 1.08rem; margin-bottom: 6px; }
  .os__card p { margin-bottom: 8px; font-size: 0.95rem; }
  .os__card .src { margin: 0; }
  .os__progress { display: none; }

  /* Jazda w bok: sekcja wysoka o długość ścieżki, wnętrze przypięte, przesunięcie z postępu przewijania. */
  .os--jazda { height: calc(100svh + var(--shift, 0px)); view-timeline: --os block; }
  .os--jazda .os__sticky { position: sticky; top: 64px; height: calc(100svh - 64px); display: flex; flex-direction: column; justify-content: center; overflow: clip; padding-block: 24px; }
  .os--jazda .os__view { overflow: visible; }
  .os--jazda .os__track { animation-name: jazda; animation-timing-function: linear; animation-fill-mode: both; }
  .os--jazda .os__progress { display: block; margin-top: 28px; height: 2px; position: relative; }
  .os--jazda .os__progress::before { content: ''; position: absolute; inset: 0 var(--gut); background: var(--line); }
  .os--jazda .os__progress i { position: absolute; inset: 0 var(--gut); background: var(--accent); transform-origin: 0 50%; animation-name: pasek; animation-timing-function: linear; animation-fill-mode: both; }
  .os--jazda .os__card, .os--jazda .os__dot { animation-name: wejscie; animation-timing-function: linear; animation-fill-mode: both; }
  /* Timeline w osobnych regułach: minifikator skleja go ze skrótem `animation`, a Chrome odrzuca taki skrót w całości. */
  .os.os--jazda .os__track, .os.os--jazda .os__progress i { animation-timeline: --os; animation-range: contain 0% contain 100%; }
  .os.os--jazda .os__card, .os.os--jazda .os__dot { animation-timeline: --os; animation-range: contain var(--a, 0%) contain var(--b, 10%); }
  .os--jazda .od-razu .os__card, .os--jazda .od-razu .os__dot { animation-name: none; }
  @keyframes jazda { to { transform: translateX(calc(-1 * var(--shift, 0px))); } }
  @keyframes pasek { from { transform: scaleX(0); } }
  @keyframes wejscie { from { opacity: 0.001; transform: translateY(12px); } }

  @media (max-width: 760px) {
    .os__item { width: 80vw; }
    .os--jazda .os__sticky { top: 96px; height: calc(100svh - 96px); }
    .os__card p { font-size: 0.92rem; }
  }
</style>
