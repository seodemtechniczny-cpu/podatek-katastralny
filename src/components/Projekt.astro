---
import projekt from '../data/pl/projekt-2848.json';
import obecny from '../data/pl/obecny-podatek.json';

const s27 = obecny.stawki_maksymalne.find((s) => s.rok === 2027)!;
const zl = (n: number) => n.toLocaleString('pl-PL', { minimumFractionDigits: 2 });
const glowne = ['Podstawa opodatkowania', '1. i 2. lokal lub dom', '3. i kolejne', 'Rola gminy'];
const reszta = projekt.parametry.filter((p) => !glowne.includes(p.co));
// Na głównej skrót z linkiem, na /projekt-ustawy/ pełna treść z nagłówkiem h1.
const { strona = false } = Astro.props as { strona?: boolean };
const H = strona ? 'h1' : 'h2';
const base = import.meta.env.BASE_URL;
const fmt = (iso: string) => new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<section class="section" id="projekt" aria-labelledby="projekt-h">
  <div class="wrap">
    {strona ? <p class="eyebrow"><a href={base}>Strona główna</a> / Projekt ustawy</p> : <p class="eyebrow">Projekt ustawy · druk nr {projekt.druk}</p>}
    <H id="projekt-h">{strona ? `Projekt podatku od wartości mieszkań (druk nr ${projekt.druk}): co zmienia` : 'Co zmienia projekt podatku od wartości?'}</H>
    <p class="lead">Projekt dotyczy tylko budynków i lokali mieszkalnych. Zestawienie obecnych zasad z zasadami z projektu
      (wersja {projekt.wersja}). Przy każdym punkcie podajemy przepis projektu.</p>

    <div class="cmp reveal">
      <article class="cmp__col">
        <h3>Dziś</h3>
        <p class="cmp__big">do {zl(s27.budynki_mieszkalne)} zł <span>za m² rocznie</span></p>
        <p>Podatek liczy się od powierzchni użytkowej. Stawkę maksymalną ogłasza minister finansów, gmina uchwala swoją,
          nie wyższą. Wartość mieszkania i liczba mieszkań nie mają znaczenia.</p>
        <p class="src">Stawka maksymalna na 2027 r.: <a href={s27.zrodlo.url}>{s27.zrodlo.nazwa}</a></p>
      </article>
      <article class="cmp__col cmp__col--new">
        <h3>Według projektu</h3>
        <p class="cmp__big">0,02% <span>wartości: 1. i 2. lokal</span></p>
        <p class="cmp__big">0,5% → 1,5% <span>wartości: 3. i kolejne</span></p>
        <p>Wartość = powierzchnia × średnia cena transakcyjna m² w gminie. Za 1. i 2. lokal podatek nie może być wyższy
          niż według dotychczasowych zasad. Za 3. i kolejne stawka rośnie o 0,2 pkt proc. rocznie.</p>
        <p class="src">Art. 4 ust. 1 pkt 2a, art. 5a oraz art. 8 projektu, <a href={projekt.zrodla[2].url}>autopoprawka</a></p>
      </article>
    </div>

    {strona && <dl class="meta">
      <div><dt>Wnioskodawcy</dt><dd>{projekt.wnioskodawcy}</dd></div>
      <div><dt>Wpłynął do Sejmu</dt><dd>{fmt(projekt.wplynal)}</dd></div>
      <div><dt>Wersja</dt><dd>{projekt.wersja}</dd></div>
      <div><dt>Etap</dt><dd>{projekt.etap} · <a href={`${base}#stan`}>stan sprawy</a></dd></div>
      <div><dt>Proponowane wejście w życie</dt><dd>{fmt(projekt.wejscie_w_zycie)}</dd></div>
    </dl>}
    {!strona && <p class="more"><a class="btn btn--ghost" href={`${base}projekt-ustawy/`}>Wszystkie zasady projektu ({projekt.parametry.length}) z przepisami</a>
      <a class="btn btn--ghost" href={`${base}kalkulator/`}>Policz swój podatek</a></p>}
    {strona && <section class="params" aria-labelledby="params-h">
      <h2 id="params-h">Wszystkie zasady z projektu ({projekt.parametry.length})</h2>
      <table>
        <thead><tr><th scope="col">Kwestia</th><th scope="col">Co mówi projekt</th><th scope="col">Przepis</th></tr></thead>
        <tbody>
          {projekt.parametry.map((p) => <tr><th scope="row">{p.co}</th><td>{p.tresc}</td><td class="params__art">{p.przepis}</td></tr>)}
        </tbody>
      </table>
    </section>}
    {strona && <p class="more"><a class="btn" href={`${base}kalkulator/`}>Policz, ile wyniósłby Twój podatek</a></p>}
    <p class="src">Wnioskodawcy: {projekt.wnioskodawcy}. Źródła: {projekt.zrodla.map((z, i) => <>{i > 0 && ' · '}<a href={z.url}>{z.nazwa}</a></>)}.</p>
  </div>
</section>

<style>
  .cmp { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin: 40px 0 28px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); }
  .cmp__col { padding: clamp(20px, 3vw, 36px); }
  .cmp__col + .cmp__col { border-left: 1px solid var(--line); }
  .cmp__col h3 { font-family: var(--sans); font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); font-weight: 600; }
  .cmp__big { font: 560 clamp(1.5rem, 2.6vw, 2rem)/1.15 var(--display); margin-bottom: 14px; }
  .cmp__big span { display: block; font: 500 0.9rem/1.4 var(--sans); color: var(--ink-3); margin-top: 2px; }
  .cmp__col--new .cmp__big { color: var(--accent-text); }
  .params { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: 18px; }
  .params h2 { font-size: 1.5rem; margin: 24px 0 8px; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px 28px; margin: 0 0 8px; }
  .meta dt { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 4px; }
  .meta dd { margin: 0; font-weight: 550; line-height: 1.4; }
  .more { display: flex; flex-wrap: wrap; gap: 10px 12px; margin: 0 0 24px; }
  .params table { width: 100%; border-collapse: collapse; font-size: 0.95rem; margin-bottom: 20px; }
  .params th, .params td { text-align: left; vertical-align: top; padding: 12px 16px 12px 0; border-top: 1px solid var(--line); }
  .params thead th { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); border-top: 0; }
  .params tbody th { width: 22%; font-weight: 600; }
  .params__art { white-space: nowrap; color: var(--ink-3); font-size: 0.85rem; }
  @media (max-width: 760px) {
    .cmp { grid-template-columns: 1fr; }
    .cmp__col + .cmp__col { border-left: 0; border-top: 1px solid var(--line); }
    .params thead { display: none; }
    .params tr { display: block; border-top: 1px solid var(--line); padding: 12px 0; }
    .params th, .params td { display: block; border: 0; padding: 2px 0; width: auto !important; }
    .params__art { white-space: normal; }
  }
</style>
