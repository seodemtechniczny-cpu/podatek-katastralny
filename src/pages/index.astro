---
import Base from '../layouts/Base.astro';
import HeroMapa from '../components/HeroMapa.astro';
import Stan from '../components/Stan.astro';
import Projekt from '../components/Projekt.astro';
import Kalkulator from '../components/Kalkulator.astro';
import OsCzasu from '../components/OsCzasu.astro';
import MapaEuropy from '../components/MapaEuropy.astro';
import Newsy from '../components/Newsy.astro';
---
<Base
  intro
  title="Czy będzie podatek katastralny w Polsce? Stan sprawy, projekt, kalkulator"
  description="Czy w Polsce będzie podatek katastralny? Aktualny etap projektu w Sejmie, stawki z projektu, kalkulator i porównanie z Europą na mapie. Bezstronnie, ze źródłami."
>
  <HeroMapa />
  <Stan />
  <OsCzasu />
  <Newsy />
  <Projekt />
  <Kalkulator />
  <MapaEuropy />
</Base>
